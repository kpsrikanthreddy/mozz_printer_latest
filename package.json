{
  "name": "mozz-printer",
  "version": "1.0.0",
  "description": "Starters4U Windows Electron Print Agent for Thermal KOT and Billing",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "dev:electron": "tsc -p tsconfig.node.json && electron dist/main/index.js",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.node.json",
    "build": "vite build",
    "build:electron": "vite build && tsc -p tsconfig.node.json",
    "build:win": "npm run build:electron && electron-builder --win --x64",
    "build:win:portable": "npm run build:electron && electron-builder --win portable --x64",
    "lint": "tsc --noEmit",
    "test": "tsc -p tsconfig.node.json && node dist/test/stage3Requirements.test.js && node dist/test/agentPrint.test.js",
    "test:agent": "tsc -p tsconfig.node.json && node dist/test/agentPrint.test.js"
  },
  "keywords": [
    "electron",
    "printer",
    "thermal-printer",
    "kot",
    "pos",
    "windows"
  ],
  "author": "Starters4U Engineering",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.546.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.14.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.starters4u.mozzprinter",
    "productName": "Mozz Print Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mozz Print Agent"
    }
  }
}
